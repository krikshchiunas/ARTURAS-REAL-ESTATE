# ─────────────────────────────────────────────────────────────────────────────
# Переменные окружения. На Vercel задаются в Project → Settings → Environment
# Variables. Локально — скопируйте этот файл в .env.local и заполните.
# ─────────────────────────────────────────────────────────────────────────────

# Боевой домен сайта (Production). Используется в метаданных, sitemap, robots,
# canonical и Open Graph. БЕЗ завершающего слэша.
NEXT_PUBLIC_SITE_URL=https://example.com

# Лиды с формы → Telegram-бот. Токен у @BotFather, chat_id — id чата/канала,
# куда бот шлёт заявки (можно получить через @userinfobot или getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Аналитика и реклама (для запуска Google Ads) ───────────────────────────
# Достаточно подключить Google Tag Manager — через него ставятся и GA4, и
# конверсии Google Ads, и (при желании) Meta Pixel, без правок кода.
# Можно задать GA4 напрямую вместо/вместе с GTM.

# Google Tag Manager, формат GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4, формат G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
